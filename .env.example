# AgroConnect Configuration

# Database
DATABASE_URL=sqlite:///./agroconnect.db

# Market Data API (Data.gov.in)
MARKET_DATA_API_KEY=your_api_key_here
MARKET_DATA_API_URL=https://api.data.gov.in/resource/market_prices

# API Setu (Verification)
API_SETU_CLIENT_ID=your_client_id_here
API_SETU_CLIENT_SECRET=your_client_secret_here
API_SETU_ENABLED=false

# Transport Cost Configuration (per km)
TRANSPORT_COST_PER_KM=20

# Storage Cost Configuration (per quintal per day)
BASIC_STORAGE_COST_PER_QUINTAL_PER_DAY=5
COLD_STORAGE_COST_PER_QUINTAL_PER_DAY=15

# ML Model Configuration
ML_MODEL_PATH=./models/price_prediction/
ML_MODEL_ENABLED=true

# Demo Mode
DEMO_MODE=true
